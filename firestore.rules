rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS & ROLE ENFORCEMENT
    // ═══════════════════════════════════════════════════════════════════════

    // Admin Role Enforcement:
    // WHY CUSTOM CLAIMS (request.auth.token.admin == true) vs FIRESTORE DOCUMENT FIELD:
    // 1. SECURITY & INTEGRITY: Document fields in Firestore can be accidentally exposed or tampered with
    //    if a client-side update rule has a flaw. Firebase Auth Custom Claims are cryptographically signed
    //    JWT tokens issued exclusively by the Firebase Admin SDK / Cloud Functions, preventing any
    //    client-side privilege escalation attacks.
    // 2. PERFORMANCE & ZERO COST: Validating request.auth.token.admin == true evaluates instantly in memory
    //    with 0 additional Firestore document reads (0ms latency, $0 cost). Checking a document field
    //    requires an expensive get() lookup on every single security rule evaluation.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'superadmin' ||
        request.auth.token.email == 'closeon.st@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', {}).get('admin', false) == true
          )
        )
      );
    }

    // Verified Vendor Check:
    // User must be authenticated and have roles.vendor.status == "verified" in their users/{uid} document.
    // Includes fallback to legacy role == "vendor" or "kitchen" for smooth migration.
    function isVerifiedVendor() {
      return request.auth != null && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', {}).get('vendor', {}).get('status', '') == "verified" ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['vendor', 'kitchen']
          )
        )
      );
    }

    // Verified Rider Check:
    // User must be authenticated and have roles.rider.status == "verified" in their users/{uid} document.
    // Includes fallback to role in ['delivery', 'delivery_agent', 'rider'] for smooth migration.
    function isVerifiedRider() {
      return request.auth != null && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', {}).get('rider', {}).get('status', '') == "verified" ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['delivery', 'delivery_agent', 'rider']
          )
        )
      );
    }

    // Customer Check:
    // User is an authenticated customer.
    function isCustomer() {
      return request.auth != null;
    }

    // Check if caller is a participant in an order/delivery
    function isDeliveryOrderParticipant(order) {
      return request.auth != null && (
        isAdmin() ||
        (order != null && (
          order.get('customerId', '') == request.auth.uid ||
          order.get('user_id', '') == request.auth.uid ||
          order.get('vendorId', '') == request.auth.uid ||
          order.get('vendor_id', '') == request.auth.uid ||
          order.get('driverId', '') == request.auth.uid ||
          order.get('agentId', '') == request.auth.uid ||
          order.get('rider_id', '') == request.auth.uid ||
          order.get('riderId', '') == request.auth.uid ||
          order.get('assigned_to', '') == request.auth.uid
        ))
      );
    }

    // Verifies that a non-admin user is not attempting privilege escalation to admin,
    // cannot self-approve as a vendor/rider, and cannot change an already-assigned role.
    function isValidUserWrite() {
      let isSuper = request.auth.token.email == 'closeon.st@gmail.com';
      let reqRole = request.resource.data.get('role', 'user');
      let reqApproved = request.resource.data.get('is_approved', false);
      let notAdminEscalation = 
        reqRole != 'admin' &&
        request.resource.data.get('roles', {}).get('admin', false) != true &&
        (!('is_superadmin' in request.resource.data) || request.resource.data.is_superadmin != true) &&
        (!('is_admin' in request.resource.data) || request.resource.data.is_admin != true) &&
        (!('admin' in request.resource.data) || request.resource.data.admin != true) &&
        !('permissions' in request.resource.data);

      let partnerApprovalSafe = 
        !(reqRole in ['vendor', 'delivery', 'kitchen', 'delivery_agent', 'rider']) || 
        reqApproved == false || 
        (resource != null && resource.data.get('is_approved', false) == true);

      let roleChangeSafe = 
        resource == null || 
        resource.data.get('role', null) == null || 
        resource.data.get('role', '') == '' ||
        resource.data.get('role', '') == reqRole;

      return isSuper || isAdmin() || (notAdminEscalation && partnerApprovalSafe && roleChangeSafe);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // USERS IDENTITY & MULTI-ROLE DOCUMENT
    // ═══════════════════════════════════════════════════════════════════════
    match /users/{userId} {
      // Users can read their own profile; admins can read all profiles;
      // any authenticated user can read vendor or rider profiles (needed for storefront & order tracking)
      allow get: if (
        request.auth != null && (
          request.auth.uid == userId ||
          isAdmin() ||
          resource.data.get('role', '') in ['vendor', 'delivery', 'kitchen', 'delivery_agent', 'rider']
        )
      ) || (
        resource.data.get('role', '') in ['vendor', 'kitchen']
      );

      // Admins can list all users; authenticated users can list approved vendors (for storefront)
      allow list: if isAdmin() || (
        resource.data.get('role', '') in ['vendor', 'kitchen']
      );

      // User can create their own profile without privilege escalation
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        isValidUserWrite();

      // User can update their own profile without privilege escalation
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          isValidUserWrite()
        )
      );

      allow delete: if isAdmin();

      // User saved delivery addresses
      match /addresses/{addressId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // User in-app notifications
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // VENDOR-ONLY COLLECTIONS
    // ═══════════════════════════════════════════════════════════════════════

    // Daily Menus — readable by all (for storefront & menu discovery), writable only by verified vendors or admins
    match /daily_menus/{menuId} {
      allow read: if true;
      allow write: if isVerifiedVendor() && (
        request.resource.data.get('vendor_id', '') == request.auth.uid ||
        request.resource.data.get('vendorId', '') == request.auth.uid ||
        isAdmin()
      );
    }

    // Discount Codes — readable by authenticated users, writable only by verified vendors or admins
    match /discount_codes/{codeId} {
      allow read: if request.auth != null;
      allow write: if isVerifiedVendor() && (
        request.resource.data.get('vendor_id', '') == request.auth.uid ||
        request.resource.data.get('vendorId', '') == request.auth.uid ||
        isAdmin()
      );
    }

    // Batches — order grouping managed by verified vendors or admins
    match /batches/{batchId} {
      allow list, get: if request.auth != null && (isAdmin() || isVerifiedRider() || isVerifiedVendor());
      allow create: if (isVerifiedVendor() && (
        request.resource.data.get('vendor_id', '') == request.auth.uid ||
        request.resource.data.get('vendorId', '') == request.auth.uid
      )) || isAdmin();
      allow update: if isVerifiedVendor() || isVerifiedRider() || isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // RIDER-ONLY COLLECTIONS
    // ═══════════════════════════════════════════════════════════════════════

    // Driver Profiles — managed by verified riders or admins
    match /driver_profiles/{driverId} {
      allow read, write: if request.auth != null && request.auth.uid == driverId;
      allow read, write: if isAdmin();
      allow read: if isVerifiedRider();
      allow get: if request.auth != null;
    }

    // Rider Trips — active delivery routes for verified riders
    match /rider_trips/{tripId} {
      allow get: if request.auth != null;
      allow list: if isVerifiedRider() || isVerifiedVendor() || isAdmin();
      allow create: if isVerifiedRider() || isAdmin();
      allow update: if isVerifiedRider() ||
        (request.auth.uid in resource.data.get('vendorIds', [])) ||
        (request.auth.uid in resource.data.get('vendor_ids', [])) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // Rider Payments & Payouts — readable by verified rider or admin
    match /rider_payments/{paymentId} {
      allow get: if request.auth != null && (resource == null || resource.data.riderId == request.auth.uid || isAdmin());
      allow list: if isVerifiedRider() || isAdmin();
      allow write: if isAdmin();
    }

    match /agent_payouts/{payoutId} {
      allow read: if request.auth != null && (resource.data.agentId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Discrepancies & Reviews — reported by verified riders
    match /pickup_discrepancies/{discId} {
      allow list, get: if isVerifiedRider() || isAdmin();
      allow create: if isVerifiedRider();
      allow update, delete: if isAdmin();
    }

    match /failed_delivery_reviews/{reviewId} {
      allow list, get: if isVerifiedRider() || isAdmin();
      allow create: if isVerifiedRider();
      allow update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ADMIN-ONLY & AUDIT COLLECTIONS
    // ═══════════════════════════════════════════════════════════════════════
    // Partner Applications (Kitchen & Rider onboarding from gig.dabzzo.in)
    match /partner_applications/{appId} {
      allow create: if true; // anyone can submit an onboarding application
      allow read: if isAdmin() || (request.auth != null && resource.data.get('phone', '') == request.auth.token.get('phone_number', ''));
      allow update, delete: if isAdmin();
    }

    // Audit logs — append-only audit trail readable only by custom claim admins
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // System Events (Notification bus) — written strictly by Cloud Functions / Admin SDK
    match /system_events/{eventId} {
      allow read: if request.auth != null && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Promotional Offers Carousel — public read for customer carousel & admin, authenticated write
    match /offers/{offerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public Platform Overview Stats — public read for landing page counters & stats, admin write
    match /platform_stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ORDERS & SUBSCRIPTIONS (Customer + Vendor + Rider Shared)
    // ═══════════════════════════════════════════════════════════════════════

    match /orders/{orderId} {
      allow list, get: if request.auth != null && (
        isAdmin() || isVerifiedRider() || isVerifiedVendor() ||
        resource.data.get('user_id', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('vendor_id', '') == request.auth.uid ||
        resource.data.get('vendorId', '') == request.auth.uid ||
        resource.data.get('rider_id', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid ||
        resource.data.get('driverId', '') == request.auth.uid ||
        resource.data.get('agentId', '') == request.auth.uid
      );
      allow create: if request.auth != null && (
        request.resource.data.get('user_id', '') == request.auth.uid ||
        request.resource.data.get('customerId', '') == request.auth.uid ||
        isAdmin()
      );
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          isVerifiedRider() && (
            resource.data.get('driverId', '') == request.auth.uid ||
            resource.data.get('agentId', '') == request.auth.uid ||
            resource.data.get('rider_id', '') == request.auth.uid ||
            resource.data.get('riderId', '') == request.auth.uid ||
            resource.data.get('assigned_to', '') == request.auth.uid
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['total_amount', 'payment_status', 'items', 'customerId', 'user_id', 'vendorId', 'vendor_id', 'otp', 'delivery_otp', 'amount', 'status'])
        ) ||
        (
          isVerifiedVendor() && (resource.data.get('vendor_id', '') == request.auth.uid || resource.data.get('vendorId', '') == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['total_amount', 'payment_status', 'items', 'customerId', 'user_id', 'driverId', 'agentId', 'rider_id', 'riderId', 'otp', 'delivery_otp', 'amount'])
        ) ||
        (
          (resource.data.get('user_id', '') == request.auth.uid || resource.data.get('customerId', '') == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryPreference', 'deliveryAddress', 'delivery_address', 'instructions', 'status', 'updatedAt', 'updated_at']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
            (request.resource.data.status in ['skipped', 'cancelled'] && resource.data.status in ['created', 'pending'])
          )
        )
      );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, create: if isAdmin() || (
          exists(/databases/$(database)/documents/orders/$(orderId)) &&
          isDeliveryOrderParticipant(get(/databases/$(database)/documents/orders/$(orderId)).data)
        );
        allow update, delete: if isAdmin();
      }
    }

    match /deliveries/{deliveryId} {
      allow create, delete: if isAdmin();
      allow get: if isAdmin() ||
                  (isCustomer() && (resource.data.get('customerId', '') == request.auth.uid || resource.data.get('user_id', '') == request.auth.uid)) ||
                  (isVerifiedVendor() && (resource.data.get('vendorId', '') == request.auth.uid || resource.data.get('vendor_id', '') == request.auth.uid)) ||
                  (isVerifiedRider() && (
                    resource.data.get('agentId', '') == request.auth.uid ||
                    resource.data.get('driverId', '') == request.auth.uid ||
                    resource.data.get('rider_id', '') == request.auth.uid ||
                    resource.data.get('riderId', '') == request.auth.uid
                  ));
      allow list: if request.auth != null && (
        isAdmin() || isVerifiedRider() || isVerifiedVendor() ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('user_id', '') == request.auth.uid ||
        resource.data.get('vendorId', '') == request.auth.uid ||
        resource.data.get('vendor_id', '') == request.auth.uid ||
        resource.data.get('rider_id', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow update: if isAdmin() || (
        isVerifiedRider() && (
          resource.data.get('agentId', '') == request.auth.uid ||
          resource.data.get('driverId', '') == request.auth.uid ||
          resource.data.get('rider_id', '') == request.auth.uid ||
          resource.data.get('riderId', '') == request.auth.uid
        )
      );
    }

    match /subscriptions/{subId} {
      allow get: if request.auth != null && (
        resource == null ||
        resource.data.user_id == request.auth.uid ||
        resource.data.vendor_id == request.auth.uid ||
        isAdmin()
      );
      allow list: if request.auth != null;
      allow create: if request.auth != null && (request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update: if request.auth != null && (
        resource.data.user_id == request.auth.uid ||
        resource.data.vendor_id == request.auth.uid ||
        isAdmin()
      );
      allow delete: if request.auth != null && (
        resource.data.user_id == request.auth.uid ||
        isAdmin()
      );
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && (
        request.resource.data.user_id == request.auth.uid ||
        request.resource.data.get('customerId', '') == request.auth.uid
      );
      allow update: if request.auth != null && (
        resource.data.user_id == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.user_id == request.auth.uid ||
        isAdmin()
      );
    }

    match /support_tickets/{ticketId} {
      allow read: if request.auth != null && (resource.data.submitter_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.submitter_id == request.auth.uid;
      allow update: if request.auth != null && (resource.data.submitter_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /order_status_logs/{logId} {
      allow list, get: if request.auth != null;
      allow create: if request.auth != null && (
        isAdmin() || isVerifiedRider() || isVerifiedVendor() ||
        request.resource.data.get('actor', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /skip_requests/{reqId} {
      allow read: if request.auth != null && (resource == null || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null && (request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
    }

    match /subscription_swap_allowances/{docId} {
      allow get, list: if request.auth != null && (resource == null || resource.data.user_id == request.auth.uid || isAdmin());
      // Users can initialize their own swap allowance doc on subscription creation
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /swap_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.user_id == request.auth.uid ||
        resource.data.get('target_user_id', '') == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
    }

    match /swap_broadcasts/{broadcastId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow create: if request.auth != null && (
        request.resource.data.get('user_id', '') == request.auth.uid ||
        request.resource.data.get('recipient_user_id', '') == request.auth.uid ||
        isAdmin()
      );
      allow update: if request.auth != null && (
        resource.data.get('user_id', '') == request.auth.uid ||
        resource.data.get('recipient_user_id', '') == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin() || (request.auth != null && (
        resource.data.get('user_id', '') == request.auth.uid ||
        resource.data.get('recipient_user_id', '') == request.auth.uid
      ));
    }

    match /user_credits/{creditId} {
      allow get, list: if request.auth != null && (resource == null || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null && (request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update: if request.auth != null && (
        isAdmin() ||
        (resource.data.user_id == request.auth.uid && request.resource.data.user_id == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    match /free_meal_vouchers/{voucherId} {
      allow read: if request.auth != null && (resource == null || resource.data.user_id == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /payment_history/{paymentId} {
      allow read: if request.auth != null && (resource == null || resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /payment_subscriptions/{docId} {
      allow read: if request.auth != null && (resource == null || resource.data.user_id == request.auth.uid || isAdmin());
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          resource.data.user_id == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['user_id', 'amount', 'plan_id', 'razorpay_subscription_id'])
        )
      );
      allow create, delete: if isAdmin();
    }

    match /pricingConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vendor_payouts/{payoutId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.vendor_id == request.auth.uid);
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.vendor_id == request.auth.uid);
      allow write: if isAdmin();
    }

    // Dynamic margin rules (quantity tiers) — global admin config, public read
    match /system_settings/margin_rules {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

